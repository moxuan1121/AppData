#!/bin/sh

# Keep ElleKit's injection directory alive while dpkg removes this package.
# Without a foreign entry, dpkg can remove an otherwise empty shared parent
# directory and ElleKit then reports its installation as corrupted.
inject_dir="/var/jb/Library/MobileSubstrate/DynamicLibraries"
keep_file="$inject_dir/.com.moxuan.appdata.keep"

if [ -d "$inject_dir" ]; then
    : > "$keep_file"
fi

exit 0
